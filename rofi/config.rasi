configuration {
  show-icons: true;
}

* {
  font: "JetBrainsMono Nerd Font 12";
  bg: rgba(30, 30, 46, 0.85);
  bg-alt: #2a2a3c;
  fg: #cdd6f4;
  accent: #ff69b4;
}

window {
  width: 600px;
  border: 2px;
  border-radius: 12px;
  border-color: @accent;
  background-color: @bg;
}

inputbar {
  padding: 10px;
  border-radius: 8px;
  background-color: @bg-alt;
}

listview {
  lines: 6;
  spacing: 6px;
}

element {
  padding: 8px;
  border-radius: 8px;
}

element normal.normal {
  background-color: transparent;
  text-color: #cdd6f4;
}

element alternate.normal {
  background-color: transparent;
  text-color: #cdd6f4;
}

element selected.normal {
  background-color: #ff69b4;
  text-color: #1e1e2e;
}

inputbar {
  padding: 10px;
  border-radius: 8px;
  background-color: @bg-alt;
}

entry {
  text-color: #ffffff;
  placeholder-color: #888888;
}

prompt {
  enabled: false;
}

mode-switcher {
  enabled: false;
}

